{
  "name": "@eldrex/connectors",
  "version": "1.6.1",
  "description": "DevDiff Messaging Connectors Registry",
  "type": "module",
  "main": "./dist/registry.js",
  "module": "./dist/registry.js",
  "types": "./dist/registry.d.ts",
  "exports": {
    ".": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "devdiff",
    "connectors",
    "slack",
    "discord"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EldrexDelosReyesBula/devdiff.git",
    "directory": "packages/connectors"
  },
  "author": "Eldrex Delos Reyes Bula <eldrexdelosreyesbula@gmail.com>",
  "license": "MIT",
  "devdiff": {
    "packageType": "connector",
    "capabilities": [
      "messaging-connectors",
      "webhook-dispatch",
      "slack-integration",
      "discord-integration"
    ],
    "exports": {
      "main": "./src/registry.ts",
      "classes": ["ConnectorRegistry", "SlackConnector", "DiscordConnector"],
      "functions": ["getConnector", "dispatchNotification"],
      "types": ["ConnectorConfig", "NotificationPayload"]
    },
    "dependencies": {
      "required": [],
      "optional": ["@slack/web-api", "discord.js"]
    },
    "agentContext": {
      "purpose": "Messaging connectors registry for DevDiff. Provides pre-built dispatchers for Slack, Discord, Microsoft Teams, and custom webhooks.",
      "whenToUse": "When you need to send generated changelogs or security alerts to external communication channels.",
      "keyConcepts": [
        "Pluggable connector interface",
        "Supports webhooks and native APIs",
        "Configurable notification channels"
      ],
      "commonPatterns": [
        "Get connector → format payload → dispatch notification"
      ],
      "quickStart": {
        "install": "npm install @eldrex/connectors",
        "import": "import { getConnector } from '@eldrex/connectors';",
        "basicUsage": "const slack = getConnector('slack'); await slack.send(payload);"
      }
    }
  }
}
