{
    "name":  "@eldrex/connectors",
    "version":  "1.5.0",
    "description":  "DevDiff Messaging Connectors Registry",
    "type":  "module",
    "main":  "./dist/registry.js",
    "module":  "./dist/registry.js",
    "types":  "./dist/registry.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/registry.d.ts",
                              "import":  "./dist/registry.js",
                              "default":  "./dist/registry.js"
                          }
                },
    "files":  [
                  "dist"
              ],
    "scripts":  {
                    "build":  "tsup",
                    "dev":  "tsup --watch",
                    "typecheck":  "tsc --noEmit"
                },
    "devDependencies":  {
                            "tsup":  "^8.0.0",
                            "typescript":  "^5.5.0"
                        },
    "publishConfig":  {
                          "registry":  "https://registry.npmjs.org"
                      },
    "keywords":  [
                     "devdiff",
                     "connectors",
                     "slack",
                     "discord"
                 ],
    "author":  "Eldrex Delos Reyes Bula \u003celdrexdelosreyesbula@gmail.com\u003e",
    "license":  "MIT"
}
