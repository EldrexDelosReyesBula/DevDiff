{
  "name": "devdiff",
  "displayName": "DevDiff",
  "description": "Privacy-first, BYOAI codebase intelligence and automated release note synthesizer",
  "version": "1.9.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "publisher": "ebula",
  "icon": "asset/devdiff.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "compile": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "vscode:prepublish": "npm run compile",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eldrex/core": "workspace:*"
  },
  "optionalDependencies": {
    "ollama": "^0.5.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devdiff-sidebar",
          "title": "DevDiff",
          "icon": "asset/devdiff.svg"
        }
      ]
    },
    "views": {
      "devdiff-sidebar": [
        {
          "id": "devdiff-changelog",
          "name": "Changelog Explorer",
          "type": "tree",
          "icon": "$(git-commit)"
        },
        {
          "id": "devdiff.chatPanel",
          "name": "Q&A Assistant",
          "type": "webview",
          "icon": "$(comment-discussion)"
        },
        {
          "id": "devdiff.securityPanel",
          "name": "Security & Compliance",
          "type": "webview",
          "icon": "$(shield)"
        },
        {
          "id": "devdiff.settingsPanel",
          "name": "Settings & Personas",
          "type": "webview",
          "icon": "$(settings-gear)"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "devdiff.chat",
        "name": "devdiff",
        "description": "DevDiff natural language changelog intelligence & codebase Q&A assistant"
      }
    ],
    "commands": [
      {
        "command": "devdiff.showChangelog",
        "title": "DevDiff: Show Changelog"
      },
      {
        "command": "devdiff.showMenu",
        "title": "DevDiff: Quick Menu"
      },
      {
        "command": "devdiff.openFullChat",
        "title": "DevDiff: Open Full Editor Chat Tab"
      },
      {
        "command": "devdiff.explainChanges",
        "title": "DevDiff: Explain Staged Changes"
      },
      {
        "command": "devdiff.toggleWatch",
        "title": "DevDiff: Toggle Auto-Watch"
      },
      {
        "command": "devdiff.showOutput",
        "title": "DevDiff: Show Output Panel"
      },
      {
        "command": "devdiff.generateChangelog",
        "title": "DevDiff: Generate Changelog"
      },
      {
        "command": "devdiff.generateDiagram",
        "title": "DevDiff: Generate Diagram"
      },
      {
        "command": "devdiff.securityScan",
        "title": "DevDiff: Security Scan"
      },
      {
        "command": "devdiff.explainSelection",
        "title": "DevDiff: Explain Selected Code"
      },
      {
        "command": "devdiff.askAI",
        "title": "DevDiff: Ask DevDiff (natural language)"
      },
      {
        "command": "devdiff.showProjectSummary",
        "title": "DevDiff: Show Project Summary"
      },
      {
        "command": "devdiff.devtools.inspectContext",
        "title": "DevDiff DevTools: Inspect Repository Context"
      },
      {
        "command": "devdiff.devtools.exportPrompt",
        "title": "DevDiff DevTools: Export AI Prompt"
      },
      {
        "command": "devdiff.devtools.testAI",
        "title": "DevDiff DevTools: AI Latency & Connectivity Diagnostic"
      },
      {
        "command": "devdiff.devtools.mockDiff",
        "title": "DevDiff DevTools: Simulate Synthetic Diff"
      }
    ],
    "keybindings": [
      {
        "command": "devdiff.generateChangelog",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "editorTextFocus"
      },
      {
        "command": "devdiff.generateDiagram",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus"
      },
      {
        "command": "devdiff.securityScan",
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x",
        "when": "editorTextFocus"
      },
      {
        "command": "devdiff.explainSelection",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorTextFocus"
      },
      {
        "command": "devdiff.askAI",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "DevDiff",
      "properties": {
        "devdiff.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Auto-start DevDiff monitoring session when VS Code opens"
        },
        "devdiff.autoGenerate": {
          "type": "boolean",
          "default": false,
          "description": "Auto-generate explanations when changes are staged"
        },
        "devdiff.persona": {
          "type": "string",
          "default": "developer",
          "enum": [
            "developer",
            "ceo",
            "educator",
            "pm",
            "compliance",
            "robot",
            "data-analyst",
            "journalist"
          ],
          "description": "AI persona for explanations"
        },
        "devdiff.showGutterAnnotations": {
          "type": "boolean",
          "default": true,
          "description": "Show inline annotations in the editor gutter"
        },
        "devdiff.security": {
          "type": "object",
          "description": "Security settings for the DevDiff extension",
          "default": {},
          "properties": {
            "restrictFileAccess": {
              "type": "boolean",
              "default": true,
              "description": "Only access files within the current workspace boundary"
            },
            "maxFileSize": {
              "type": "number",
              "default": 10485760,
              "description": "Maximum file size to process in bytes (default: 10MB)"
            },
            "blockExternalScripts": {
              "type": "boolean",
              "default": true,
              "description": "Block execution of any external or dynamically loaded scripts"
            }
          }
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EldrexDelosReyesBula/devdiff.git",
    "directory": "packages/vscode"
  },
  "author": "Eldrex Delos Reyes Bula <eldrexdelosreyesbula@gmail.com>",
  "license": "MIT"
}
