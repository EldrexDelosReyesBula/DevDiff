# TypeScript sources (built to dist/ by tsup)
src/
**/*.ts
!dist/**/*.d.ts

# Test files
**/*.test.ts
**/*.spec.ts
tests/
__tests__/

# Development configs
tsconfig.json
tsup.config.ts
.eslintrc*
.prettierrc*
biome.json

# Node modules (not needed in VSIX; bundled by tsup)
node_modules/

# Build artifacts not part of the extension
*.map
*.tsbuildinfo

# Documentation and repo files
docs/
*.md
!README.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE

# CI and tooling
.github/
.vscode/
.devdiff/
coverage/
