{
  "name": "@eldrex/mcp",
  "version": "1.9.0",
  "description": "DevDiff MCP Server v2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server-v2": {
      "types": "./dist/server-v2.d.ts",
      "import": "./dist/server-v2.js",
      "default": "./dist/server-v2.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./universal-config": {
      "types": "./dist/universal-config.d.ts",
      "import": "./dist/universal-config.js",
      "default": "./dist/universal-config.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eldrex/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.1"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "devdiff",
    "mcp",
    "server"
  ],
  "author": "Eldrex Delos Reyes Bula <eldrexdelosreyesbula@gmail.com>",
  "license": "MIT"
}
